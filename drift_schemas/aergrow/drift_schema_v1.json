  "fixed_sql": [
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NULL, \"status\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"device_name\" TEXT NULL, \"duration_ms\" INTEGER NOT NULL DEFAULT 0, \"distance_dm\" INTEGER NOT NULL DEFAULT 0, \"average_pace_cs\" INTEGER NULL, \"average_watts\" INTEGER NULL, \"average_stroke_rate\" REAL NULL, \"stroke_count\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "samples",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"samples\" (\"session_id\" INTEGER NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"t_ms\" INTEGER NOT NULL, \"distance_dm\" INTEGER NOT NULL, \"pace_cs\" INTEGER NULL, \"watts\" INTEGER NULL, \"stroke_rate\" INTEGER NULL, \"heart_rate\" INTEGER NULL, \"calories\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "strokes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"strokes\" (\"session_id\" INTEGER NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"t_ms\" INTEGER NOT NULL, \"distance_dm\" INTEGER NOT NULL, \"stroke_number\" INTEGER NOT NULL, \"drive_length_meters\" REAL NOT NULL, \"drive_time_ms\" INTEGER NOT NULL, \"recovery_time_ms\" INTEGER NOT NULL, \"peak_force_newtons\" REAL NOT NULL, \"average_force_newtons\" REAL NOT NULL, \"watts\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "raw_packets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"raw_packets\" (\"session_id\" INTEGER NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"t_ms\" INTEGER NOT NULL, \"characteristic_id\" TEXT NOT NULL, \"bytes\" BLOB NOT NULL);"
        }
      ]
    },
    {
      "name": "samples_session_time",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX samples_session_time ON samples (session_id, t_ms)"
        }
